<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/logs_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/logs_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/btn_logs_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/logs_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_headline_medium"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logs_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:padding="12dp">

        <TextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:text="@string/logs_empty"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:padding="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_logs_copy"
            style="@style/Widget.Dsh.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_compact"
            android:layout_weight="1"
            android:text="@string/logs_copy" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_logs_clear"
            style="@style/Widget.Dsh.Button.Soft"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height_compact"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/logs_clear" />
    </LinearLayout>
</LinearLayout>
