<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <!-- 1. SESSION LAYER (Active Remote WebView + Minimal White App Bar)  -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/session_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Minimal White App Bar (48dp height) -->
        <LinearLayout
            android:id="@+id/session_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/app_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btn_session_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/session_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/session_app_bar_title"
                android:textSize="@dimen/text_title_app_bar"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />

            <!-- Status Pill (Dot + Text) -->
            <LinearLayout
                android:id="@+id/session_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="8dp">

                <View
                    android:id="@+id/session_status_dot"
                    android:layout_width="@dimen/status_dot_size"
                    android:layout_height="@dimen/status_dot_size"
                    android:background="@drawable/bg_segmented_active" />

                <TextView
                    android:id="@+id/session_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/status_connected"
                    android:textSize="@dimen/text_micro"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Refresh Button -->
            <ImageView
                android:id="@+id/btn_session_refresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Refresh" />

            <!-- Settings Button -->
            <ImageView
                android:id="@+id/btn_session_settings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings" />
        </LinearLayout>

        <!-- 2dp LinearProgressIndicator at bottom of App Bar -->
        <ProgressBar
            android:id="@+id/session_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_bar_height"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <!-- 1dp Separator under App Bar -->
        <View
            android:id="@+id/session_app_bar_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- WebView & Error Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- WebView Body -->
            <WebView
                android:id="@+id/main_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Full-Screen Error State Overlay -->
            <LinearLayout
                android:id="@+id/session_error_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/canvas"
                android:padding="32dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/session_connecting_spinner"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/error_icon"
                    android:layout_width="@dimen/icon_size_error"
                    android:layout_height="@dimen/icon_size_error"
                    android:src="@drawable/ic_computer_offline"
                    android:contentDescription="Error Icon" />

                <TextView
                    android:id="@+id/error_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/error_offline_title"
                    android:textSize="@dimen/text_headline_medium"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/error_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/error_offline_body"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_error_retry"
                    style="@style/Widget.Dsh.Button.Outlined"
                    android:layout_width="200dp"
                    android:layout_height="@dimen/btn_height_outlined"
                    android:layout_marginTop="24dp"
                    android:text="@string/btn_retry" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 2. DEVICE HOME LAYER (Flow 1: Device List & Pairing Launcher)     -->
    <!-- ================================================================= -->
    <ScrollView
        android:id="@+id/home_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/canvas"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_title"
                        android:textSize="@dimen/text_headline_large"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_subtitle"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_home_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Settings" />
            </LinearLayout>

            <!-- Saved desktop instances: one card per connection -->
            <LinearLayout
                android:id="@+id/home_instance_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty State Card (when no device saved) -->
            <LinearLayout
                android:id="@+id/home_empty_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card"
                android:padding="24dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_computer"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/home_empty_title"
                    android:textSize="@dimen/text_headline_medium"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_empty_desc"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Primary Action: Scan to Add -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_home_add_scan"
                style="@style/Widget.Dsh.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height_primary"
                android:text="@string/home_btn_scan_add" />

            <!-- Secondary Action: Manual Code -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_home_add_manual"
                style="@style/Widget.Dsh.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height_outlined"
                android:layout_marginTop="12dp"
                android:text="@string/home_btn_manual_add" />
        </LinearLayout>
    </ScrollView>

    <!-- 3. PAIRING LAYER (Flow 2: Segmented Control [Scan | Manual])      -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/pair_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/canvas"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top App Bar for Pairing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btn_pair_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/pair_title"
                android:textSize="@dimen/text_title_app_bar"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Segmented Control [ 扫码绑定 | 手动输入 ] -->
                <LinearLayout
                    android:id="@+id/pair_segmented_container"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segmented_container"
                    android:padding="3dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tab_scan"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/pair_tab_scan"
                        android:textSize="@dimen/text_body_medium"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_segmented_active" />

                    <TextView
                        android:id="@+id/tab_manual"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/pair_tab_manual"
                        android:textSize="@dimen/text_body_medium"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- SECTION A: QR Scanner Mode -->
                <LinearLayout
                    android:id="@+id/pair_scan_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pair_scan_instruction"
                        android:textSize="@dimen/text_headline_medium"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/pair_scan_hint"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/text_secondary"
                        android:gravity="center" />

                    <!-- Square Scanner Viewfinder (240x240dp) with corner brackets -->
                    <FrameLayout
                        android:layout_width="@dimen/viewfinder_size"
                        android:layout_height="@dimen/viewfinder_size"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/viewfinder_frame">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_qr_scan"
                            android:tint="@color/text_secondary" />
                    </FrameLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_launch_scanner"
                        style="@style/Widget.Dsh.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_height_primary"
                        android:text="@string/pair_btn_launch_camera" />
                </LinearLayout>

                <!-- SECTION B: Manual Input Mode -->
                <LinearLayout
                    android:id="@+id/pair_manual_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pair_input_label"
                            android:textSize="@dimen/text_body_medium"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/btn_pair_paste"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pair_btn_paste"
                            android:textColor="@color/accent"
                            android:textSize="@dimen/text_caption"
                            android:fontFamily="sans-serif-medium"
                            android:padding="6dp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/pair_input_link"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="top|start"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:hint="@string/pair_input_hint"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="@dimen/text_code"
                        android:fontFamily="monospace"
                        android:inputType="textMultiLine|textNoSuggestions" />

                    <!-- Danger-colored error text -->
                    <TextView
                        android:id="@+id/pair_error_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/pair_error_invalid_link"
                        android:textColor="@color/danger"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_submit_pair"
                        style="@style/Widget.Dsh.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_height_primary"
                        android:layout_marginTop="20dp"
                        android:text="@string/pair_btn_submit" />
                </LinearLayout>

                <!-- SECTION C: Waiting for Desktop Confirmation -->
                <LinearLayout
                    android:id="@+id/pair_waiting_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone"
                    android:paddingTop="32dp">

                    <ProgressBar
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/warning" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/waiting_title"
                        android:textSize="@dimen/text_headline_medium"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/waiting_desc"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_waiting_continue"
                        style="@style/Widget.Dsh.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_height_outlined"
                        android:layout_marginTop="32dp"
                        android:text="@string/waiting_btn_continue" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_waiting_cancel"
                        style="@style/Widget.Dsh.Button.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_height_outlined"
                        android:layout_marginTop="12dp"
                        android:text="@string/waiting_btn_cancel" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/layer_settings" />
    <include layout="@layout/layer_logs" />
    <include layout="@layout/layer_instance" />
</FrameLayout>
