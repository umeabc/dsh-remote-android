<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rounded border of viewfinder -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_default" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <solid android:color="#1A000000" />
        </shape>
    </item>

    <!-- Top-Left Corner Bracket (Horizontal + Vertical) -->
    <item android:gravity="top|start" android:width="28dp" android:height="4dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/radius_default" />
            <solid android:color="@color/surface" />
        </shape>
    </item>
    <item android:gravity="top|start" android:width="4dp" android:height="28dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/radius_default" />
            <solid android:color="@color/surface" />
        </shape>
    </item>

    <!-- Top-Right Corner Bracket -->
    <item android:gravity="top|end" android:width="28dp" android:height="4dp">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="@dimen/radius_default" />
            <solid android:color="@color/surface" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="4dp" android:height="28dp">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="@dimen/radius_default" />
            <solid android:color="@color/surface" />
        </shape>
    </item>

    <!-- Bottom-Left Corner Bracket -->
    <item android:gravity="bottom|start" android:width="28dp" android:height="4dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="@dimen/radius_default" />
            <solid android:color="@color/surface" />
        </shape>
    </item>
    <item android:gravity="bottom|start" android:width="4dp" android:height="28dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="@dimen/radius_default" />
            <solid android:color="@color/surface" />
        </shape>
    </item>

    <!-- Bottom-Right Corner Bracket -->
    <item android:gravity="bottom|end" android:width="28dp" android:height="4dp">
        <shape android:shape="rectangle">
            <corners android:bottomRightRadius="@dimen/radius_default" />
            <solid android:color="@color/surface" />
        </shape>
    </item>
    <item android:gravity="bottom|end" android:width="4dp" android:height="28dp">
        <shape android:shape="rectangle">
            <corners android:bottomRightRadius="@dimen/radius_default" />
            <solid android:color="@color/surface" />
        </shape>
    </item>
</layer-list>
